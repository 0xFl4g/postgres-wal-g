{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
  ],
  // The Dockerfile has POSTGRES_VERSION + WAL_G_VERSION ARGs and a
  // `FROM postgres:${POSTGRES_VERSION}` line. We don't want Renovate
  // bumping the FROM tag automatically — the version is templated in
  // by the build matrix in .github/workflows/build.yml and changing
  // the default in the Dockerfile would only affect local builds.
  //
  // Instead, Renovate watches WAL-G upstream and proposes a PR bumping
  // every WAL-G version site in lockstep: WAL_G_VERSION_DEFAULT in
  // build.yml (what releases ship), the hardcoded version in test.yml
  // (what CI tests — must not drift from what ships), the Dockerfile
  // ARG default (local builds), and the README examples.
  customManagers: [
    {
      customType: "regex",
      fileMatch: [
        "^\\.github/workflows/build\\.yml$",
        "^\\.github/workflows/test\\.yml$",
        "^Dockerfile$",
        "^README\\.md$",
      ],
      matchStrings: [
        // Matches `WAL_G_VERSION_DEFAULT: v3.0.5` (build.yml),
        // `WAL_G_VERSION=v3.0.5` (test.yml, Dockerfile ARG, README).
        "WAL_G_VERSION(?:_DEFAULT)?[=:]\\s*(?<currentValue>v[0-9.]+)",
      ],
      depNameTemplate: "wal-g/wal-g",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^(?<version>v[0-9.]+)$",
    },
  ],
  packageRules: [
    // Group GH-Action bumps together — they fire often. Actions are
    // pinned to major tags (@vN), not digests, matching the org-wide
    // style; Renovate bumps the major when a new one is released.
    {
      matchManagers: ["github-actions"],
      groupName: "github-actions",
    },
  ],
  prConcurrentLimit: 3,
}
